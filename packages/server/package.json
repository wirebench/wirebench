{
  "name": "@wirebench/server",
  "version": "2.1.1",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "description": "Wirebench Server: sign-in, teams and shared workspaces for Wirebench, self-hosted.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "wirebench-server": "./dist/bin.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-host.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. --project server-unit --project server-integration",
    "dev": "node --watch dist/bin.js serve"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.1",
    "@node-saml/node-saml": "^5.1.0",
    "@wirebench/engine": "workspace:*",
    "@xmldom/xmldom": "^0.8.10",
    "bcrypt-pbkdf": "1.0.2",
    "croner": "10.0.1",
    "fastify": "^5.12.6",
    "graphql": "^17.0.2",
    "nodemailer": "10.1.4",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "ulidx": "^2.4.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@wirebench/host": "workspace:*",
    "@wirebench/wire": "workspace:*",
    "esbuild": "^0.28.2",
    "xml-crypto": "^6.1.2"
  }
}
