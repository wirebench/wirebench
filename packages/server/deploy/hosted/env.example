# Copy to `.env` beside compose.yaml and fill in. Placeholders only: no domain is owned yet.
APP_DOMAIN=example-app.test
SITE_DOMAIN=example-site.test
ACME_EMAIL=operator@example-site.test
# Let's Encrypt's staging endpoint, for a first try: https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA_SERVER=
POSTGRES_PASSWORD=
WIREBENCH_APP_DB_PASSWORD=
# The control role's (wirebench_control), apart from the app role's: openssl rand -hex 24
WIREBENCH_CONTROL_DB_PASSWORD=
# openssl rand -base64 32
WIREBENCH_SECRETS_KEY=
# At least 32 bytes, never changed: openssl rand -base64 48
WIREBENCH_AUDIT_CHAIN_KEY=
SMTP_URL=smtps://user:password@mail.example-site.test:465
SMTP_FROM=teams@example-site.test
# The proxy listener's bearer token, for Traefik and the server alike: openssl rand -hex 32
PROXY_TOKEN=
# Paddle, the merchant of record (sandbox placeholders shown; production takes live_… and its own price).
# The notification destination's secret key (pdl_ntfset_…) goes in secrets/paddle_webhook_secret, not here.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_replace_with_the_client_side_token
PADDLE_TEAM_PRICE_ID=pri_test_replace_with_the_team_seat_price
# WIREBENCH_VERSION=
