{
  "name": "@wirebench/cli",
  "version": "2.1.1",
  "license": "Apache-2.0",
  "mcpName": "io.github.wirebench/wirebench",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wirebench/wirebench.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "imports": {
      "#ssh": "./dist/vendor/ssh/index.js"
    }
  },
  "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
  "bin": {
    "wirebench": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b && node scripts/bundle-agent.mjs",
    "test": "vitest run --root ../.. --project cli-unit --project cli-integration",
    "typecheck": "tsc -b",
    "prepack": "node scripts/vendor-ssh.mjs && node scripts/bundle-agent.mjs --no-sourcemap"
  },
  "imports": {
    "#ssh": "@wirebench/ssh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@wirebench/engine": "workspace:*",
    "bcrypt-pbkdf": "1.0.2",
    "graphql": "^17.0.2",
    "node-hid": "3.4.0",
    "ssh2": "1.17.0",
    "undici": "8.12.2",
    "yaml": "2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@wirebench/agent": "workspace:*",
    "@wirebench/host": "workspace:*",
    "@wirebench/ssh": "workspace:*",
    "@wirebench/wire": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
