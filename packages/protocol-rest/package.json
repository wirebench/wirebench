{
  "name": "@wirebench/protocol-rest",
  "version": "0.0.0",
  "private": true,
  "description": "Wirebench engine: REST, OpenAPI, the HTTP-client formats, webhooks and SSE. Composed by @wirebench/engine, which vendors it; not published on its own.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "imports": {
    "#core/*": "@wirebench/core/*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@stoplight/spectral-core": "1.24.0",
    "@stoplight/spectral-parsers": "1.0.5",
    "@stoplight/spectral-ref-resolver": "1.0.5",
    "@wirebench/core": "workspace:*",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  }
}
