{
  "name": "@wirebench/engine",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xml": {
      "development": "./src/xml/index.ts",
      "types": "./dist/xml/index.d.ts",
      "default": "./dist/xml/index.js"
    },
    "./test-helpers": "./test/helpers/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project engine-unit --project engine-integration",
    "test:perf": "vitest run --root ../.. --project engine-perf",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fontoxpath": "^3.34.0",
    "node-forge": "^1.3.1",
    "ulidx": "^2.4.1",
    "undici": "^8",
    "xml-crypto": "^6.1.2",
    "xmllint-wasm": "5.3.0",
    "yaml": "^2.9",
    "zod": "^4.6.1"
  }
}
