{
  "name": "@wirebench/engine",
  "version": "2.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xml": {
      "development": "./src/xml/index.ts",
      "types": "./dist/xml/index.d.ts",
      "default": "./dist/xml/index.js"
    },
    "./rest": {
      "development": "./src/rest/browser.ts",
      "types": "./dist/rest/browser.d.ts",
      "default": "./dist/rest/browser.js"
    },
    "./json": {
      "development": "./src/json/cursor.ts",
      "types": "./dist/json/cursor.d.ts",
      "default": "./dist/json/cursor.js"
    },
    "./grpc": {
      "development": "./src/grpc/browser.ts",
      "types": "./dist/grpc/browser.d.ts",
      "default": "./dist/grpc/browser.js"
    },
    "./ws": {
      "development": "./src/ws/browser.ts",
      "types": "./dist/ws/browser.d.ts",
      "default": "./dist/ws/browser.js"
    },
    "./detect": {
      "development": "./src/import-detect.ts",
      "types": "./dist/import-detect.d.ts",
      "default": "./dist/import-detect.js"
    },
    "./test-helpers": "./test/helpers/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project engine-unit --project engine-integration",
    "test:perf": "vitest run --root ../.. --project engine-perf",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fontoxpath": "^3.34.0",
    "jsonpath-plus": "^10.4.0",
    "node-forge": "^1.3.1",
    "protobufjs": "^8.8.0",
    "ulidx": "^2.4.1",
    "undici": "^8",
    "xml-crypto": "^6.1.2",
    "xmllint-wasm": "5.3.0",
    "yaml": "^2.9",
    "zod": "^4.6.1"
  }
}
