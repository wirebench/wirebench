{
  "name": "@wirebench/engine",
  "version": "2.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wirebench/wirebench.git",
    "directory": "packages/engine"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./xml": {
        "types": "./dist/xml.d.ts",
        "default": "./dist/xml.js"
      },
      "./rest": {
        "types": "./dist/rest.d.ts",
        "default": "./dist/rest.js"
      },
      "./json": {
        "types": "./dist/json.d.ts",
        "default": "./dist/json.js"
      },
      "./grpc": {
        "types": "./dist/grpc.d.ts",
        "default": "./dist/grpc.js"
      },
      "./asyncapi": {
        "types": "./dist/asyncapi.d.ts",
        "default": "./dist/asyncapi.js"
      },
      "./snapshot": {
        "types": "./dist/snapshot.d.ts",
        "default": "./dist/snapshot.js"
      },
      "./ws": {
        "types": "./dist/ws.d.ts",
        "default": "./dist/ws.js"
      },
      "./detect": {
        "types": "./dist/import-detect.d.ts",
        "default": "./dist/import-detect.js"
      }
    },
    "imports": {
      "#core/*": "./dist/vendor/core/*.js",
      "#protocol-soap/*": "./dist/vendor/protocol-soap/*.js",
      "#protocol-rest/*": "./dist/vendor/protocol-rest/*.js",
      "#protocol-grpc/*": "./dist/vendor/protocol-grpc/*.js",
      "#protocol-ws/*": "./dist/vendor/protocol-ws/*.js",
      "#protocol-mcp/*": "./dist/vendor/protocol-mcp/*.js",
      "#protocol-graphql/*": "./dist/vendor/protocol-graphql/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xml": {
      "development": "./src/xml.ts",
      "types": "./dist/xml.d.ts",
      "default": "./dist/xml.js"
    },
    "./rest": {
      "development": "./src/rest.ts",
      "types": "./dist/rest.d.ts",
      "default": "./dist/rest.js"
    },
    "./json": {
      "development": "./src/json.ts",
      "types": "./dist/json.d.ts",
      "default": "./dist/json.js"
    },
    "./grpc": {
      "development": "./src/grpc.ts",
      "types": "./dist/grpc.d.ts",
      "default": "./dist/grpc.js"
    },
    "./asyncapi": {
      "development": "./src/asyncapi.ts",
      "types": "./dist/asyncapi.d.ts",
      "default": "./dist/asyncapi.js"
    },
    "./snapshot": {
      "development": "./src/snapshot.ts",
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./ws": {
      "development": "./src/ws.ts",
      "types": "./dist/ws.d.ts",
      "default": "./dist/ws.js"
    },
    "./detect": {
      "development": "./src/import-detect.ts",
      "types": "./dist/import-detect.d.ts",
      "default": "./dist/import-detect.js"
    },
    "./test-helpers": "./test/helpers/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project engine-unit --project engine-integration",
    "test:perf": "vitest run --root ../.. --project engine-perf",
    "typecheck": "tsc -b",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && node scripts/vendor-packages.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@stoplight/spectral-core": "1.24.0",
    "@stoplight/spectral-parsers": "1.0.5",
    "@stoplight/spectral-ref-resolver": "1.0.5",
    "@xmldom/xmldom": "^0.9.12",
    "fontoxpath": "^3.34.0",
    "graphql": "^17.0.2",
    "jose": "^6.2.12",
    "jsonpath-plus": "^10.4.0",
    "node-forge": "^1.3.1",
    "protobufjs": "^8.8.0",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "~5.9.3",
    "ulidx": "^2.4.1",
    "undici": "^8",
    "xml-crypto": "^6.1.2",
    "xmllint-wasm": "5.3.0",
    "yaml": "^2.9",
    "zod": "^4.6.1"
  },
  "optionalDependencies": {
    "kerberos": "7.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "@wirebench/core": "workspace:*",
    "@wirebench/protocol-soap": "workspace:*",
    "@wirebench/protocol-rest": "workspace:*",
    "@wirebench/protocol-grpc": "workspace:*",
    "@wirebench/protocol-ws": "workspace:*",
    "@wirebench/protocol-mcp": "workspace:*",
    "@wirebench/protocol-graphql": "workspace:*"
  },
  "imports": {
    "#core/*": "@wirebench/core/*",
    "#protocol-soap/*": "@wirebench/protocol-soap/*",
    "#protocol-rest/*": "@wirebench/protocol-rest/*",
    "#protocol-grpc/*": "@wirebench/protocol-grpc/*",
    "#protocol-ws/*": "@wirebench/protocol-ws/*",
    "#protocol-mcp/*": "@wirebench/protocol-mcp/*",
    "#protocol-graphql/*": "@wirebench/protocol-graphql/*"
  }
}
