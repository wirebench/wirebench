{
  "name": "wirebench-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.13.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @wirebench/desktop dev",
    "docs:dev": "pnpm --filter @wirebench/docs-site dev",
    "docs:build": "pnpm --filter @wirebench/docs-site build",
    "docs:preview": "pnpm --filter @wirebench/docs-site preview",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "package": "pnpm build && pnpm --filter @wirebench/desktop package",
    "package:mac": "pnpm build && pnpm --filter @wirebench/desktop package:mac",
    "package:win": "pnpm build && pnpm --filter @wirebench/desktop package:win",
    "package:linux": "pnpm build && pnpm --filter @wirebench/desktop package:linux",
    "test": "vitest run --project '!engine-perf' --project '!engine-interop' --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "pnpm --filter @wirebench/engine build && vitest run --project '!engine-perf' --project '!engine-interop' --coverage --passWithNoTests",
    "test:perf": "vitest run --project engine-perf",
    "test:e2e": "pnpm --filter @wirebench/e2e test",
    "bench": "vitest bench --run",
    "test:interop": "WIREBENCH_NETWORK_TESTS=1 vitest run --project engine-interop",
    "test:wss-xmlsec": "pnpm --filter @wirebench/engine build && node scripts/wss-xmlsec-check.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc -b && pnpm --filter @wirebench/desktop typecheck && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "check": "pnpm typecheck && pnpm lint && pnpm wsi:docs --check && pnpm contrast:check && pnpm check:doc-paths && pnpm check:banned-terms && pnpm licenses:third-party --check && pnpm test && pnpm test:perf",
    "check:tests": "pnpm typecheck && pnpm test && pnpm test:perf",
    "fixtures:refresh": "node scripts/fixtures-refresh.ts",
    "wsi:docs": "node scripts/wsi-docs.ts",
    "contrast:check": "node scripts/contrast-check.ts",
    "check:doc-paths": "node scripts/check-doc-paths.ts",
    "check:banned-terms": "node scripts/check-banned-terms.ts",
    "licenses:third-party": "node scripts/third-party-licenses.ts"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/node-forge": "^1.3.14",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.15"
    }
  }
}
