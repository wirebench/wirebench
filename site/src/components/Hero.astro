---
/** The home page's opening: headline, one sentence, the two buttons and the response-pane screenshot. */
import { DOCS_LINKS, docsUrl } from '../docs-links.ts';
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <h1>One workbench for SOAP, REST and gRPC.</h1>
  <p class="hero__lede">
    Import a WSDL, an OpenAPI document or a .proto set, get a request from the contract, send it, and read the response.
  </p>
  <p class="hero__actions">
    <a class="button button--primary" href={`${base}download/`}>Download</a>
    <a class="button" href={docsUrl(DOCS_LINKS.home)}>Read the docs</a>
  </p>
  <div class="hero__shot">
    <img
      src="/wirebench/images/home/response.png"
      width="1280"
      height="800"
      alt="A SOAP request and its response in the Wirebench shell"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: 3rem 2rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.15;
  }

  .hero__lede {
    max-width: 40rem;
    margin: 0 0 1.5rem;
    color: var(--wb-fg-muted);
    font-size: 1.125rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 2rem;
  }

  .hero__shot {
    overflow: hidden;
    border: 1px solid var(--wb-border);
    border-radius: 8px;
  }

  .hero__shot img {
    display: block;
    width: 100%;
  }

  @media (max-width: 40rem) {
    .hero__shot img {
      width: 150%;
      max-width: none;
    }
  }
</style>
