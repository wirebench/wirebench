---
/** One "Beyond the desktop" card: a title, one sentence and a link to its guide. */
import { DOCS_LINKS, docsUrl } from '../docs-links.ts';
interface Props {
  title: string;
  text: string;
  slug: (typeof DOCS_LINKS)[keyof typeof DOCS_LINKS];
}
const { title, text, slug } = Astro.props;
---

<article class="card">
  <h3>{title}</h3>
  <p>{text}</p>
  <a href={docsUrl(slug)}>Read the guide</a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--wb-border);
    border-radius: 8px;
    background: var(--wb-bg-raised);
  }

  h3 {
    margin: 0 0 0.5rem;
  }

  p {
    flex: 1;
    margin: 0 0 1rem;
    color: var(--wb-fg-muted);
  }
</style>
