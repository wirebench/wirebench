{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirebench.github.io/wirebench/docs/schemas/v8/manifest.schema.json",
  "title": "Wirebench project file: Project manifest",
  "description": "Project format 8: `wirebench.yaml`.",
  "type": "object",
  "properties": {
    "formatVersion": { "type": "number", "const": 8 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "settings": {
      "type": "object",
      "properties": {
        "cacheDefinitions": { "type": "boolean" },
        "defaultTimeoutMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "resourceRoot": { "type": "string" },
        "prettyPrintResponses": { "type": "boolean" }
      },
      "required": ["cacheDefinitions", "defaultTimeoutMs", "prettyPrintResponses"],
      "additionalProperties": {}
    },
    "properties": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string" }
    },
    "disabled": { "type": "array", "items": { "type": "string" } },
    "activeEnvironmentId": { "type": "string" },
    "writtenBy": { "type": "string" }
  },
  "required": ["formatVersion", "id", "name", "settings", "properties"],
  "additionalProperties": {}
}
