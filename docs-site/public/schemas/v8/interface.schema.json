{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirebench.github.io/wirebench/docs/schemas/v8/interface.schema.json",
  "title": "Wirebench project file: SOAP interface",
  "description": "Project format 8: `interfaces/*/interface.yaml`.",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "const": "soap" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "definitionUrl": { "type": "string" },
    "cacheDefinition": { "type": "boolean" },
    "targetNamespace": { "type": "string" },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "auth": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["none", "basic", "ntlm"] },
                  "username": { "type": "string" },
                  "passwordRef": { "type": "string" },
                  "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "domain": { "type": "string" },
                  "workstation": { "type": "string" },
                  "preemptive": { "type": "boolean" }
                },
                "required": ["type"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "bearer" },
                  "tokenRef": { "type": "string" },
                  "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "scheme": { "type": "string" }
                },
                "required": ["type"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "api-key" },
                  "name": { "type": "string" },
                  "valueRef": { "type": "string" },
                  "valueEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "in": { "type": "string", "enum": ["header", "query"] }
                },
                "required": ["type", "name", "in"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "oauth2" },
                  "grant": { "type": "string", "enum": ["client-credentials", "authorization-code"] },
                  "tokenUrl": { "type": "string" },
                  "authorizationUrl": { "type": "string" },
                  "clientId": { "type": "string" },
                  "clientSecretRef": { "type": "string" },
                  "clientSecretEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "scopes": { "default": [], "type": "array", "items": { "type": "string" } },
                  "audience": { "type": "string" },
                  "clientAuth": { "default": "basic", "type": "string", "enum": ["basic", "body"] },
                  "pkce": { "default": true, "type": "boolean" },
                  "refreshTokenRef": { "type": "string" }
                },
                "required": ["type", "grant", "tokenUrl", "clientId"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "kerberos" },
                  "spn": { "type": "string" },
                  "principal": { "type": "string" },
                  "username": { "type": "string" },
                  "domain": { "type": "string" },
                  "passwordRef": { "type": "string" },
                  "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
                },
                "required": ["type"],
                "additionalProperties": {}
              }
            ]
          },
          "authMode": { "type": "string", "enum": ["override", "complement"] },
          "trustInvalid": { "type": "boolean" }
        },
        "required": ["id", "name", "url", "authMode"],
        "additionalProperties": {}
      }
    },
    "defaultEndpointId": { "type": "string" },
    "wsa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "version": { "type": "string", "enum": ["2005/08", "2004/08"] },
        "mustUnderstand": { "type": "string", "enum": ["none", "true", "false"] },
        "action": { "type": "string" },
        "to": { "type": "string" },
        "messageId": { "type": "string" },
        "replyTo": { "type": "string" },
        "from": { "type": "string" },
        "faultTo": { "type": "string" },
        "relatesTo": { "type": "string" },
        "relationshipType": { "type": "string" },
        "addDefaultAction": { "type": "boolean" },
        "addDefaultTo": { "type": "boolean" },
        "generateMessageId": { "type": "boolean" }
      },
      "required": ["enabled"],
      "additionalProperties": {}
    },
    "auth": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["none", "basic", "ntlm"] },
            "username": { "type": "string" },
            "passwordRef": { "type": "string" },
            "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "domain": { "type": "string" },
            "workstation": { "type": "string" },
            "preemptive": { "type": "boolean" }
          },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "bearer" },
            "tokenRef": { "type": "string" },
            "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scheme": { "type": "string" }
          },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "api-key" },
            "name": { "type": "string" },
            "valueRef": { "type": "string" },
            "valueEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "in": { "type": "string", "enum": ["header", "query"] }
          },
          "required": ["type", "name", "in"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "oauth2" },
            "grant": { "type": "string", "enum": ["client-credentials", "authorization-code"] },
            "tokenUrl": { "type": "string" },
            "authorizationUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecretRef": { "type": "string" },
            "clientSecretEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scopes": { "default": [], "type": "array", "items": { "type": "string" } },
            "audience": { "type": "string" },
            "clientAuth": { "default": "basic", "type": "string", "enum": ["basic", "body"] },
            "pkce": { "default": true, "type": "boolean" },
            "refreshTokenRef": { "type": "string" }
          },
          "required": ["type", "grant", "tokenUrl", "clientId"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "kerberos" },
            "spn": { "type": "string" },
            "principal": { "type": "string" },
            "username": { "type": "string" },
            "domain": { "type": "string" },
            "passwordRef": { "type": "string" },
            "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          },
          "required": ["type"],
          "additionalProperties": {}
        }
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "bindingName": { "type": "string" },
          "slug": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
        },
        "required": ["name", "bindingName", "slug", "order"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["kind", "id", "name", "order", "definitionUrl", "cacheDefinition", "endpoints", "wsa", "operations"],
  "additionalProperties": {}
}
