{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirebench.github.io/wirebench/docs/schemas/v8/soap-request.schema.json",
  "title": "Wirebench project file: SOAP request",
  "description": "Project format 8: `interfaces/*/operations/*/*.request.yaml`.",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "const": "soap" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "description": { "type": "string" },
    "endpointId": { "type": "string" },
    "endpointUrl": { "type": "string" },
    "soapVersion": { "type": "string", "enum": ["1.1", "1.2"] },
    "soapAction": { "type": "string" },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "value": { "type": "string" } },
        "required": ["name", "value"],
        "additionalProperties": {}
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "contentType": { "type": "string" },
          "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "part": { "type": "string" },
          "type": { "type": "string", "enum": ["XOP", "MIME", "SWAREF", "CONTENT", "UNKNOWN"] },
          "contentId": { "type": "string" },
          "cached": { "type": "boolean" },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "cache" },
                  "sha256": { "type": "string", "minLength": 1 }
                },
                "required": ["kind", "sha256"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "path" },
                  "path": { "type": "string", "minLength": 1 }
                },
                "required": ["kind", "path"],
                "additionalProperties": {}
              }
            ]
          }
        },
        "required": ["id", "name", "contentType", "size", "type", "contentId", "cached", "source"],
        "additionalProperties": {}
      }
    },
    "auth": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["none", "basic", "ntlm"] },
            "username": { "type": "string" },
            "passwordRef": { "type": "string" },
            "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "domain": { "type": "string" },
            "workstation": { "type": "string" },
            "preemptive": { "type": "boolean" }
          },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "bearer" },
            "tokenRef": { "type": "string" },
            "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scheme": { "type": "string" }
          },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "api-key" },
            "name": { "type": "string" },
            "valueRef": { "type": "string" },
            "valueEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "in": { "type": "string", "enum": ["header", "query"] }
          },
          "required": ["type", "name", "in"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "oauth2" },
            "grant": { "type": "string", "enum": ["client-credentials", "authorization-code"] },
            "tokenUrl": { "type": "string" },
            "authorizationUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecretRef": { "type": "string" },
            "clientSecretEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scopes": { "default": [], "type": "array", "items": { "type": "string" } },
            "audience": { "type": "string" },
            "clientAuth": { "default": "basic", "type": "string", "enum": ["basic", "body"] },
            "pkce": { "default": true, "type": "boolean" },
            "refreshTokenRef": { "type": "string" }
          },
          "required": ["type", "grant", "tokenUrl", "clientId"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "kerberos" },
            "spn": { "type": "string" },
            "principal": { "type": "string" },
            "username": { "type": "string" },
            "domain": { "type": "string" },
            "passwordRef": { "type": "string" },
            "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          },
          "required": ["type"],
          "additionalProperties": {}
        }
      ]
    },
    "wsa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "version": { "type": "string", "enum": ["2005/08", "2004/08"] },
        "mustUnderstand": { "type": "string", "enum": ["none", "true", "false"] },
        "action": { "type": "string" },
        "to": { "type": "string" },
        "messageId": { "type": "string" },
        "replyTo": { "type": "string" },
        "from": { "type": "string" },
        "faultTo": { "type": "string" },
        "relatesTo": { "type": "string" },
        "relationshipType": { "type": "string" },
        "addDefaultAction": { "type": "boolean" },
        "addDefaultTo": { "type": "boolean" },
        "generateMessageId": { "type": "boolean" }
      },
      "required": ["enabled"],
      "additionalProperties": {}
    },
    "wssOutgoingRef": { "type": "string" },
    "wssIncomingRef": { "type": "string" },
    "properties": {
      "type": "object",
      "properties": {
        "encoding": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "bindAddress": { "type": "string" },
        "followRedirects": { "type": "boolean" },
        "skipSoapAction": { "type": "boolean" },
        "enableMtom": { "type": "boolean" },
        "forceMtom": { "type": "boolean" },
        "inlineResponseAttachments": { "type": "boolean" },
        "expandMtomAttachments": { "type": "boolean" },
        "disableMultiparts": { "type": "boolean" },
        "encodeAttachments": { "type": "boolean" },
        "enableInlineFiles": { "type": "boolean" },
        "removeEmptyContent": { "type": "boolean" },
        "entitizeProperties": { "type": "boolean" },
        "prettyPrint": { "type": "boolean" },
        "stripWhitespaces": { "type": "boolean" },
        "dumpFile": { "type": "string" },
        "maxSizeBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "wssPasswordType": { "type": "string", "enum": ["text", "digest"] },
        "wssTimeToLive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sslKeystoreRef": { "type": "string" }
      },
      "required": [
        "encoding",
        "followRedirects",
        "skipSoapAction",
        "enableMtom",
        "forceMtom",
        "inlineResponseAttachments",
        "expandMtomAttachments",
        "disableMultiparts",
        "encodeAttachments",
        "enableInlineFiles",
        "removeEmptyContent",
        "entitizeProperties",
        "prettyPrint",
        "stripWhitespaces"
      ],
      "additionalProperties": {}
    },
    "assertions": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "status" },
              "equals": {
                "anyOf": [
                  {
                    "anyOf": [
                      { "type": "integer", "minimum": 100, "maximum": 599 },
                      { "type": "integer", "minimum": 0, "maximum": 16 },
                      { "type": "string", "pattern": "^[1-5]xx$" },
                      {
                        "type": "string",
                        "enum": [
                          "OK",
                          "CANCELLED",
                          "UNKNOWN",
                          "INVALID_ARGUMENT",
                          "DEADLINE_EXCEEDED",
                          "NOT_FOUND",
                          "ALREADY_EXISTS",
                          "PERMISSION_DENIED",
                          "RESOURCE_EXHAUSTED",
                          "FAILED_PRECONDITION",
                          "ABORTED",
                          "OUT_OF_RANGE",
                          "UNIMPLEMENTED",
                          "INTERNAL",
                          "UNAVAILABLE",
                          "DATA_LOSS",
                          "UNAUTHENTICATED"
                        ]
                      }
                    ]
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        { "type": "integer", "minimum": 100, "maximum": 599 },
                        { "type": "integer", "minimum": 0, "maximum": 16 },
                        { "type": "string", "pattern": "^[1-5]xx$" },
                        {
                          "type": "string",
                          "enum": [
                            "OK",
                            "CANCELLED",
                            "UNKNOWN",
                            "INVALID_ARGUMENT",
                            "DEADLINE_EXCEEDED",
                            "NOT_FOUND",
                            "ALREADY_EXISTS",
                            "PERMISSION_DENIED",
                            "RESOURCE_EXHAUSTED",
                            "FAILED_PRECONDITION",
                            "ABORTED",
                            "OUT_OF_RANGE",
                            "UNIMPLEMENTED",
                            "INTERNAL",
                            "UNAVAILABLE",
                            "DATA_LOSS",
                            "UNAUTHENTICATED"
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "equals"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "soap-fault" },
              "expect": { "default": "none", "type": "string", "enum": ["none", "present"] },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["type"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "match" },
              "language": { "type": "string", "enum": ["xpath", "xquery", "jsonpath"] },
              "expression": { "type": "string", "minLength": 1 },
              "namespaces": {
                "type": "object",
                "propertyNames": { "type": "string" },
                "additionalProperties": { "type": "string" }
              },
              "equals": { "type": ["string", "number", "boolean"] },
              "matches": { "type": "string" },
              "exists": { "type": "boolean" },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "language", "expression"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "schema" },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["type"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "sla" },
              "maxMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "maxMs"],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "callback" },
              "catchUrl": { "type": "string", "minLength": 1, "maxLength": 100 },
              "withinMs": { "default": 30000, "type": "integer", "minimum": 1000, "maximum": 300000 },
              "match": {
                "default": {},
                "type": "object",
                "properties": {
                  "method": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "format": "starts_with", "pattern": "^\\/.*" },
                  "pathMatches": { "type": "string", "minLength": 1 },
                  "headers": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "equals": { "type": "string" },
                        "matches": { "type": "string" },
                        "exists": { "type": "boolean" }
                      },
                      "required": ["name"],
                      "additionalProperties": {}
                    }
                  },
                  "body": {
                    "type": "object",
                    "properties": {
                      "language": { "type": "string", "enum": ["jsonpath", "xpath"] },
                      "path": { "type": "string", "minLength": 1 },
                      "equals": { "type": "string" },
                      "matches": { "type": "string" },
                      "exists": { "type": "boolean" }
                    },
                    "required": ["language", "path"],
                    "additionalProperties": {}
                  }
                },
                "additionalProperties": {}
              },
              "expect": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "object",
                      "properties": {
                        "language": { "type": "string", "enum": ["jsonpath", "xpath"] },
                        "path": { "type": "string", "minLength": 1 },
                        "equals": { "type": "string" },
                        "matches": { "type": "string" },
                        "exists": { "type": "boolean" }
                      },
                      "required": ["language", "path"],
                      "additionalProperties": {}
                    },
                    "header": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "equals": { "type": "string" },
                        "matches": { "type": "string" },
                        "exists": { "type": "boolean" }
                      },
                      "required": ["name"],
                      "additionalProperties": {}
                    },
                    "signature": { "type": "string", "const": "verified" }
                  },
                  "additionalProperties": {}
                }
              },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "catchUrl"],
            "additionalProperties": {}
          }
        ]
      }
    },
    "orphaned": { "type": "boolean" },
    "scripts": {
      "type": "object",
      "properties": {
        "pre": { "type": "string", "minLength": 1 },
        "post": { "type": "string", "minLength": 1 },
        "api": { "default": "wirebench", "type": "string", "enum": ["wirebench", "postman"] },
        "enabled": { "default": true, "type": "boolean" },
        "secrets": {
          "default": [],
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 }
      },
      "additionalProperties": {}
    }
  },
  "required": ["kind", "id", "name", "order", "soapVersion", "headers", "attachments", "properties"],
  "additionalProperties": {}
}
