{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirebench.github.io/wirebench/docs/schemas/v8/sequence.schema.json",
  "title": "Wirebench project file: Sequence",
  "description": "Project format 8: `sequences/*.sequence.yaml`.",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "const": "sequence" },
    "version": { "type": "number", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "description": { "type": "string" },
    "settings": {
      "default": { "stopOnFailure": true },
      "type": "object",
      "properties": {
        "stopOnFailure": { "default": true, "type": "boolean" },
        "stepTimeoutMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
      },
      "additionalProperties": {}
    },
    "steps": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "request": { "type": "string", "minLength": 1 },
          "enabled": { "default": true, "type": "boolean" },
          "requestAssertions": { "default": true, "type": "boolean" },
          "transfers": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
                    "secret": { "type": "boolean" },
                    "optional": { "type": "boolean" },
                    "from": { "type": "string", "const": "body" },
                    "language": { "type": "string", "enum": ["xpath", "xquery", "jsonpath"] },
                    "expression": { "type": "string", "minLength": 1 },
                    "namespaces": {
                      "type": "object",
                      "propertyNames": { "type": "string" },
                      "additionalProperties": { "type": "string" }
                    }
                  },
                  "required": ["name", "from", "language", "expression"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
                    "secret": { "type": "boolean" },
                    "optional": { "type": "boolean" },
                    "from": { "type": "string", "const": "header" },
                    "header": { "type": "string", "minLength": 1 }
                  },
                  "required": ["name", "from", "header"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
                    "secret": { "type": "boolean" },
                    "optional": { "type": "boolean" },
                    "from": { "type": "string", "const": "status" }
                  },
                  "required": ["name", "from"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
                    "secret": { "type": "boolean" },
                    "optional": { "type": "boolean" },
                    "from": { "type": "string", "const": "cookie" },
                    "cookie": { "type": "string", "minLength": 1 }
                  },
                  "required": ["name", "from", "cookie"],
                  "additionalProperties": {}
                }
              ]
            }
          },
          "assertions": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "status" },
                    "equals": {
                      "anyOf": [
                        {
                          "anyOf": [
                            { "type": "integer", "minimum": 100, "maximum": 599 },
                            { "type": "integer", "minimum": 0, "maximum": 16 },
                            { "type": "string", "pattern": "^[1-5]xx$" },
                            {
                              "type": "string",
                              "enum": [
                                "OK",
                                "CANCELLED",
                                "UNKNOWN",
                                "INVALID_ARGUMENT",
                                "DEADLINE_EXCEEDED",
                                "NOT_FOUND",
                                "ALREADY_EXISTS",
                                "PERMISSION_DENIED",
                                "RESOURCE_EXHAUSTED",
                                "FAILED_PRECONDITION",
                                "ABORTED",
                                "OUT_OF_RANGE",
                                "UNIMPLEMENTED",
                                "INTERNAL",
                                "UNAVAILABLE",
                                "DATA_LOSS",
                                "UNAUTHENTICATED"
                              ]
                            }
                          ]
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              { "type": "integer", "minimum": 100, "maximum": 599 },
                              { "type": "integer", "minimum": 0, "maximum": 16 },
                              { "type": "string", "pattern": "^[1-5]xx$" },
                              {
                                "type": "string",
                                "enum": [
                                  "OK",
                                  "CANCELLED",
                                  "UNKNOWN",
                                  "INVALID_ARGUMENT",
                                  "DEADLINE_EXCEEDED",
                                  "NOT_FOUND",
                                  "ALREADY_EXISTS",
                                  "PERMISSION_DENIED",
                                  "RESOURCE_EXHAUSTED",
                                  "FAILED_PRECONDITION",
                                  "ABORTED",
                                  "OUT_OF_RANGE",
                                  "UNIMPLEMENTED",
                                  "INTERNAL",
                                  "UNAVAILABLE",
                                  "DATA_LOSS",
                                  "UNAUTHENTICATED"
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type", "equals"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "soap-fault" },
                    "expect": { "default": "none", "type": "string", "enum": ["none", "present"] },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "match" },
                    "language": { "type": "string", "enum": ["xpath", "xquery", "jsonpath"] },
                    "expression": { "type": "string", "minLength": 1 },
                    "namespaces": {
                      "type": "object",
                      "propertyNames": { "type": "string" },
                      "additionalProperties": { "type": "string" }
                    },
                    "equals": { "type": ["string", "number", "boolean"] },
                    "matches": { "type": "string" },
                    "exists": { "type": "boolean" },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type", "language", "expression"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "schema" },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "sla" },
                    "maxMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type", "maxMs"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "header" },
                    "header": { "type": "string", "minLength": 1 },
                    "equals": { "type": "string" },
                    "matches": { "type": "string" },
                    "exists": { "type": "boolean" },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type", "header"],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "callback" },
                    "catchUrl": { "type": "string", "minLength": 1, "maxLength": 100 },
                    "withinMs": { "default": 30000, "type": "integer", "minimum": 1000, "maximum": 300000 },
                    "match": {
                      "default": {},
                      "type": "object",
                      "properties": {
                        "method": { "type": "string", "minLength": 1 },
                        "path": { "type": "string", "format": "starts_with", "pattern": "^\\/.*" },
                        "pathMatches": { "type": "string", "minLength": 1 },
                        "headers": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string", "minLength": 1 },
                              "equals": { "type": "string" },
                              "matches": { "type": "string" },
                              "exists": { "type": "boolean" }
                            },
                            "required": ["name"],
                            "additionalProperties": {}
                          }
                        },
                        "body": {
                          "type": "object",
                          "properties": {
                            "language": { "type": "string", "enum": ["jsonpath", "xpath"] },
                            "path": { "type": "string", "minLength": 1 },
                            "equals": { "type": "string" },
                            "matches": { "type": "string" },
                            "exists": { "type": "boolean" }
                          },
                          "required": ["language", "path"],
                          "additionalProperties": {}
                        }
                      },
                      "additionalProperties": {}
                    },
                    "expect": {
                      "default": [],
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "body": {
                            "type": "object",
                            "properties": {
                              "language": { "type": "string", "enum": ["jsonpath", "xpath"] },
                              "path": { "type": "string", "minLength": 1 },
                              "equals": { "type": "string" },
                              "matches": { "type": "string" },
                              "exists": { "type": "boolean" }
                            },
                            "required": ["language", "path"],
                            "additionalProperties": {}
                          },
                          "header": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string", "minLength": 1 },
                              "equals": { "type": "string" },
                              "matches": { "type": "string" },
                              "exists": { "type": "boolean" }
                            },
                            "required": ["name"],
                            "additionalProperties": {}
                          },
                          "signature": { "type": "string", "const": "verified" }
                        },
                        "additionalProperties": {}
                      }
                    },
                    "name": { "type": "string", "minLength": 1 }
                  },
                  "required": ["type", "catchUrl"],
                  "additionalProperties": {}
                }
              ]
            }
          }
        },
        "required": ["id", "request"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["kind", "version", "id", "name", "order"],
  "additionalProperties": {}
}
