{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirebench.github.io/wirebench/docs/schemas/v8/keystores.schema.json",
  "title": "Wirebench project file: Keystore registry",
  "description": "Project format 8: `wss/keystores.yaml`.",
  "type": "object",
  "properties": {
    "keystores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "path": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["pkcs12", "pem"] },
          "passwordSecretRef": { "type": "string" },
          "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "defaultAlias": { "type": "string" }
        },
        "required": ["id", "name", "path", "type"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["keystores"],
  "additionalProperties": {}
}
