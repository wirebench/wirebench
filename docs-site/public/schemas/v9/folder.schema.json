{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirebench.github.io/wirebench/docs/schemas/v9/folder.schema.json",
  "title": "Wirebench project file: Request folder",
  "description": "Project format 9: `apis/*/requests/**/folder.yaml`.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "description": { "type": "string" },
    "auth": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["none", "basic", "ntlm"] },
            "username": { "type": "string" },
            "passwordRef": { "type": "string" },
            "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "domain": { "type": "string" },
            "workstation": { "type": "string" },
            "preemptive": { "type": "boolean" }
          },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": { "type": { "type": "string", "const": "inherit" } },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "bearer" },
            "tokenRef": { "type": "string" },
            "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scheme": { "type": "string" }
          },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "api-key" },
            "name": { "type": "string" },
            "valueRef": { "type": "string" },
            "valueEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "in": { "type": "string", "enum": ["header", "query"] }
          },
          "required": ["type", "name", "in"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "oauth2" },
            "grant": { "type": "string", "enum": ["client-credentials", "authorization-code"] },
            "tokenUrl": { "type": "string" },
            "authorizationUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecretRef": { "type": "string" },
            "clientSecretEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scopes": { "default": [], "type": "array", "items": { "type": "string" } },
            "audience": { "type": "string" },
            "clientAuth": { "default": "basic", "type": "string", "enum": ["basic", "body"] },
            "pkce": { "default": true, "type": "boolean" },
            "refreshTokenRef": { "type": "string" }
          },
          "required": ["type", "grant", "tokenUrl", "clientId"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "kerberos" },
            "spn": { "type": "string" },
            "principal": { "type": "string" },
            "username": { "type": "string" },
            "domain": { "type": "string" },
            "passwordRef": { "type": "string" },
            "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          },
          "required": ["type"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "jwt" },
            "algorithm": {
              "type": "string",
              "enum": [
                "HS256",
                "HS384",
                "HS512",
                "RS256",
                "RS384",
                "RS512",
                "ES256",
                "ES384",
                "ES512",
                "PS256",
                "PS384",
                "PS512"
              ]
            },
            "secretRef": { "type": "string" },
            "secretEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "keystoreRef": { "type": "string" },
            "alias": { "type": "string" },
            "header": { "type": "string" },
            "claims": { "default": "{}", "type": "string" },
            "issuedAt": { "default": true, "type": "boolean" },
            "expiresInSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "jwtId": { "default": false, "type": "boolean" },
            "in": { "default": "header", "type": "string", "enum": ["header", "query"] },
            "name": { "type": "string" },
            "prefix": { "type": "string" }
          },
          "required": ["type", "algorithm"],
          "additionalProperties": {}
        }
      ]
    },
    "scripts": {
      "type": "object",
      "properties": {
        "pre": { "type": "string", "minLength": 1 },
        "post": { "type": "string", "minLength": 1 },
        "api": { "default": "wirebench", "type": "string", "enum": ["wirebench", "postman"] },
        "enabled": { "default": true, "type": "boolean" },
        "secrets": {
          "default": [],
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 }
      },
      "additionalProperties": {}
    }
  },
  "required": ["id", "name", "order"],
  "additionalProperties": {}
}
