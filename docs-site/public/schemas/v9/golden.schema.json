{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirebench.github.io/wirebench/docs/schemas/v9/golden.schema.json",
  "title": "Wirebench project file: Snapshot",
  "description": "Project format 9: `**/*.golden.yaml`.",
  "type": "object",
  "properties": {
    "contentType": { "type": "string" },
    "savedAt": { "type": "string" },
    "ignore": { "type": "array", "items": { "type": "string" } },
    "body": { "type": "string" }
  },
  "required": ["savedAt", "ignore", "body"]
}
