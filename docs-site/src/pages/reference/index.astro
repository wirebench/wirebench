---
// Scalar API Reference for Wirebench
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wirebench API Reference - Scalar Explorer</title>
    <meta name="description" content="Interactive OpenAPI Reference and request tester for Wirebench engine." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #151413;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .top-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.5rem;
        background-color: #0f0e0d;
        border-bottom: 1px solid #2a2724;
        color: #ece9e3;
        font-size: 0.875rem;
      }
      .top-nav a {
        color: #d97757;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .top-nav a:hover {
        color: #e58c6e;
      }
      .top-nav .brand {
        color: #ece9e3;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <header class="top-nav">
      <div class="brand">Wirebench Engine API Reference</div>
      <a href="/getting-started/">← Back to Guides & Tutorials</a>
    </header>

    <div id="scalar-container">
      <script
        id="api-reference"
        type="application/json"
        data-configuration={JSON.stringify({
          spec: {
            url: '/specs/wirebench-api.json',
          },
          theme: 'saturn',
          darkMode: true,
          showSidebar: true,
          hideDownloadButton: false,
          customCss: `
            :root {
              --scalar-color-1: #ece9e3;
              --scalar-color-2: #a49d93;
              --scalar-color-3: #696663;
              --scalar-color-accent: #d97757;
              --scalar-background-1: #151413;
              --scalar-background-2: #1c1b19;
              --scalar-background-3: #232120;
              --scalar-border-color: #2a2724;
            }
          `
        })}
      ></script>
      <script src="https://cdn.jsdelivr.net/npm/@scalar/api-reference"></script>
    </div>
  </body>
</html>
