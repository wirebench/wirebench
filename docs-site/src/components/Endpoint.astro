---
import MethodBadge from './MethodBadge.astro';

interface Props {
  method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE' | 'SOAP' | string;
  path: string;
}

const { method, path } = Astro.props;
---

<div class="endpoint-bar">
  <MethodBadge method={method} />
  <span class="endpoint-path">{path}</span>
</div>
