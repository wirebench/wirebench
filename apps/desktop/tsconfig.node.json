{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/wire/src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "../../packages/wire/src/**/*",
    "electron.vite.config.ts",
    "vite.browser.config.ts",
    "after-pack.ts",
    "test/*.ts"
  ]
}
