    "cmdk": "^1.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.43.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.0",
