{
  "name": "@wirebench/desktop",
  "version": "2.2.0",
  "private": true,
  "description": "Wirebench \u2014 a desktop workbench for SOAP and WSDL",
  "author": {
    "name": "Wirebench contributors"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wirebench/wirebench.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
