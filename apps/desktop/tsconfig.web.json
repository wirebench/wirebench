{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/wire/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/browser/**/*",
    "../../packages/wire/src/**/*",
    "src/preload/api.d.ts",
    "src/preload/build-api.ts",
    "test/renderer/**/*",
    "test/browser/**/*",
    "test/mocks/**/*"
  ]
}
