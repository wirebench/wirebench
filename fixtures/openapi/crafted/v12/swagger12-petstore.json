{
  "swaggerVersion": "1.2",
  "apiVersion": "1.2.0",
  "basePath": "https://api.petstore.test:8443/api/v1",
  "resourcePath": "/pets",
  "info": {
    "title": "Swagger 1.2 Petstore",
    "description": "A sample Swagger 1.2 API definition"
  },
  "authorizations": {
    "api_key": {
      "type": "apiKey",
      "passAs": "header",
      "keyname": "X-API-KEY"
    },
    "basic_auth": {
      "type": "basicAuth"
    },
    "petstore_auth": {
      "type": "oauth2",
      "scopes": [
        {
          "scope": "write:pets",
          "description": "modify pets"
        },
        {
          "scope": "read:pets",
          "description": "read pets"
        }
      ],
      "grantTypes": {
        "authorization_code": {
          "tokenEndpoint": {
            "url": "https://auth.petstore.test/oauth/token",
            "tokenName": "access_token"
          },
          "authorizationEndpoint": {
            "url": "https://auth.petstore.test/oauth/authorize"
          }
        }
      }
    }
  },
  "apis": [
    {
      "path": "/pets",
      "description": "Operations about pets",
      "operations": [
        {
          "method": "GET",
          "summary": "List all pets",
          "notes": "Returns all pets from the store",
          "type": "array",
          "items": {
            "$ref": "Pet"
          },
          "nickname": "listPets",
          "parameters": [
            {
              "name": "limit",
              "description": "How many items to return",
              "required": false,
              "type": "integer",
              "format": "int32",
              "paramType": "query",
              "defaultValue": 20
            },
            {
              "name": "status",
              "description": "Filter by pet status",
              "required": false,
              "type": "string",
              "paramType": "query",
              "enum": ["available", "pending", "sold"]
            },
            {
              "name": "X-Client-Id",
              "description": "Client tracking identifier",
              "required": false,
              "type": "string",
              "paramType": "header"
            }
          ],
          "responseMessages": [
            {
              "code": 200,
              "message": "A paged array of pets"
            }
          ]
        },
        {
          "method": "POST",
          "summary": "Create a pet",
          "notes": "Creates a new pet in the store",
          "type": "Pet",
          "nickname": "createPet",
          "consumes": ["application/json"],
          "parameters": [
            {
              "name": "body",
              "description": "Pet to add to the store",
              "required": true,
              "type": "NewPet",
              "paramType": "body"
            }
          ],
          "responseMessages": [
            {
              "code": 201,
              "message": "Null response"
            }
          ]
        }
      ]
    },
    {
      "path": "/pets/{petId}",
      "description": "Operations on a single pet",
      "operations": [
        {
          "method": "GET",
          "summary": "Find pet by ID",
          "notes": "Returns a single pet",
          "type": "Pet",
          "nickname": "getPetById",
          "parameters": [
            {
              "name": "petId",
              "description": "ID of pet to return",
              "required": true,
              "type": "integer",
              "format": "int64",
              "paramType": "path"
            }
          ],
          "responseMessages": [
            {
              "code": 404,
              "message": "Pet not found"
            }
          ]
        },
        {
          "method": "DELETE",
          "summary": "Deletes a pet",
          "notes": "Removes a pet from the store",
          "type": "void",
          "nickname": "deletePet",
          "parameters": [
            {
              "name": "petId",
              "description": "Pet id to delete",
              "required": true,
              "type": "integer",
              "format": "int64",
              "paramType": "path"
            }
          ],
          "responseMessages": [
            {
              "code": 204,
              "message": "Pet deleted"
            }
          ]
        }
      ]
    },
    {
      "path": "/pets/{petId}/upload",
      "description": "Upload a file for a pet",
      "operations": [
        {
          "method": "POST",
          "summary": "Uploads an image",
          "nickname": "uploadFile",
          "consumes": ["multipart/form-data"],
          "parameters": [
            {
              "name": "petId",
              "description": "ID of pet to update",
              "required": true,
              "type": "integer",
              "paramType": "path"
            },
            {
              "name": "additionalMetadata",
              "description": "Additional data to pass to server",
              "required": false,
              "type": "string",
              "paramType": "form"
            },
            {
              "name": "file",
              "description": "file to upload",
              "required": false,
              "type": "File",
              "paramType": "form"
            }
          ]
        }
      ]
    }
  ],
  "models": {
    "Category": {
      "id": "Category",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "NewPet": {
      "id": "NewPet",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "Pet": {
      "id": "Pet",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Unique identifier for the pet"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "$ref": "Category"
        },
        "status": {
          "type": "string",
          "description": "pet status in the store",
          "enum": ["available", "pending", "sold"]
        }
      }
    }
  }
}
