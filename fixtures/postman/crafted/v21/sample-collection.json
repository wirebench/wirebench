{
  "info": {
    "_postman_id": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
    "name": "Sample Postman Collection",
    "description": "A crafted Postman collection testing folders, variables, parameters, auth, and bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.com",
      "type": "string"
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{myToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Users",
      "description": "User management endpoints",
      "auth": {
        "type": "apikey",
        "apikey": [
          { "key": "key", "value": "X-API-Key", "type": "string" },
          { "key": "value", "value": "{{apiKey}}", "type": "string" },
          { "key": "in", "value": "header", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/users?role=admin&limit=20&archived=false",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "users"],
              "query": [
                {
                  "key": "role",
                  "value": "admin",
                  "description": "Filter by user role"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Page size"
                },
                {
                  "key": "archived",
                  "value": "false",
                  "disabled": true,
                  "description": "Include archived users"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Debug",
                "value": "true",
                "disabled": true,
                "description": "Debug mode trace"
              }
            ]
          }
        },
        {
          "name": "Get User Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/users/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "users", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "usr_12345",
                  "description": "The unique user ID"
                }
              ]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "users"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"role\": \"developer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update User Form",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/users/:userId/profile",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "users", ":userId", "profile"],
              "variable": [
                {
                  "key": "userId",
                  "value": "usr_12345"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "bio",
                  "value": "Engineer and open source enthusiast",
                  "description": "Short bio"
                },
                {
                  "key": "location",
                  "value": "London",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Upload User Avatar",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/users/:userId/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "users", ":userId", "avatar"],
              "variable": [
                {
                  "key": "userId",
                  "value": "usr_12345"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "caption",
                  "value": "Profile photo",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "avatar.png",
                  "contentType": "image/png"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}
