<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="RpcEncodedService"
                  targetNamespace="urn:wb:rpcenc"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"
                  xmlns:tns="urn:wb:rpcenc"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <wsdl:types>
    <xsd:schema targetNamespace="urn:wb:rpcenc"
                xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                xmlns:tns="urn:wb:rpcenc"
                xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"
                xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
      <!-- The classic SOAP 1.1 section 5 array declaration. -->
      <xsd:complexType name="ArrayOfInt">
        <xsd:complexContent>
          <xsd:restriction base="soapenc:Array">
            <xsd:attribute ref="soapenc:arrayType" wsdl:arrayType="xsd:int[]"/>
          </xsd:restriction>
        </xsd:complexContent>
      </xsd:complexType>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="SumRequest">
    <wsdl:part name="values" type="tns:ArrayOfInt"/>
    <wsdl:part name="label" type="xsd:string"/>
  </wsdl:message>
  <wsdl:message name="SumResponse">
    <wsdl:part name="total" type="xsd:int"/>
  </wsdl:message>

  <wsdl:portType name="RpcEncodedPortType">
    <wsdl:operation name="Sum">
      <wsdl:input message="tns:SumRequest"/>
      <wsdl:output message="tns:SumResponse"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="RpcEncodedBinding" type="tns:RpcEncodedPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Sum">
      <soap:operation soapAction="urn:wb:rpcenc:Sum" style="rpc"/>
      <wsdl:input>
        <soap:body use="encoded" namespace="urn:wb:rpcenc"
                   encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="encoded" namespace="urn:wb:rpcenc"
                   encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="RpcEncodedService">
    <wsdl:port name="RpcEncodedPort" binding="tns:RpcEncodedBinding">
      <soap:address location="http://example.invalid/rpc-encoded"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
