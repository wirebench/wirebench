<?xml version="1.0" encoding="UTF-8"?>
<!--
  Version 2 of the "versioned" fixture pair. Relative to ../v1/service.wsdl it:
    - adds the Subtract operation (a "new" operation for planUpdate),
    - adds a REQUIRED `lang` and an OPTIONAL `note` child to the Echo input element
      (a "changed" operation; `note` appears only when "Recreate optional elements" is on),
    - removes the Legacy operation (a "removed" operation, whose saved requests are orphaned),
    - adds a second port, VersionedAltPort, at a second address (an added endpoint).
  Everything else is byte-for-byte the same, so a diff of the two files is the plan.
-->
<wsdl:definitions name="VersionedService"
                  targetNamespace="urn:wb:versioned"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="urn:wb:versioned"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <wsdl:types>
    <xsd:schema targetNamespace="urn:wb:versioned" elementFormDefault="qualified"
                xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:element name="Echo">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="text" type="xsd:string"/>
            <xsd:element name="lang" type="xsd:string"/>
            <xsd:element name="note" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="EchoResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="text" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Add">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="a" type="xsd:int"/>
            <xsd:element name="b" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="AddResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="result" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Subtract">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="a" type="xsd:int"/>
            <xsd:element name="b" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="SubtractResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="result" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="EchoRequest"><wsdl:part name="body" element="tns:Echo"/></wsdl:message>
  <wsdl:message name="EchoReply"><wsdl:part name="body" element="tns:EchoResponse"/></wsdl:message>
  <wsdl:message name="AddRequest"><wsdl:part name="body" element="tns:Add"/></wsdl:message>
  <wsdl:message name="AddReply"><wsdl:part name="body" element="tns:AddResponse"/></wsdl:message>
  <wsdl:message name="SubtractRequest"><wsdl:part name="body" element="tns:Subtract"/></wsdl:message>
  <wsdl:message name="SubtractReply"><wsdl:part name="body" element="tns:SubtractResponse"/></wsdl:message>

  <wsdl:portType name="VersionedPortType">
    <wsdl:operation name="Echo">
      <wsdl:documentation>Echoes the supplied text back to the caller.</wsdl:documentation>
      <wsdl:input message="tns:EchoRequest"/>
      <wsdl:output message="tns:EchoReply"/>
    </wsdl:operation>
    <wsdl:operation name="Add">
      <wsdl:input message="tns:AddRequest"/>
      <wsdl:output message="tns:AddReply"/>
    </wsdl:operation>
    <wsdl:operation name="Subtract">
      <wsdl:documentation>Added in v2.</wsdl:documentation>
      <wsdl:input message="tns:SubtractRequest"/>
      <wsdl:output message="tns:SubtractReply"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="VersionedBinding" type="tns:VersionedPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Echo">
      <soap:operation soapAction="urn:wb:versioned:Echo" style="document"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="Add">
      <soap:operation soapAction="urn:wb:versioned:Add" style="document"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="Subtract">
      <soap:operation soapAction="urn:wb:versioned:Subtract" style="document"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="VersionedService">
    <wsdl:port name="VersionedPort" binding="tns:VersionedBinding">
      <soap:address location="http://example.invalid/versioned"/>
    </wsdl:port>
    <wsdl:port name="VersionedAltPort" binding="tns:VersionedBinding">
      <soap:address location="http://example.invalid/versioned-alt"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
