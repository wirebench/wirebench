<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="RpcLiteralService"
                  targetNamespace="urn:wb:rpclit"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="urn:wb:rpclit"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <wsdl:types>
    <xsd:schema targetNamespace="urn:wb:rpclit"
                xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                xmlns:tns="urn:wb:rpclit">
      <xsd:complexType name="Options">
        <xsd:sequence>
          <xsd:element name="rounding" type="xsd:string"/>
          <xsd:element name="scale" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="MultiplyRequest">
    <wsdl:part name="a" type="xsd:int"/>
    <wsdl:part name="b" type="xsd:int"/>
    <wsdl:part name="opts" type="tns:Options"/>
  </wsdl:message>
  <wsdl:message name="MultiplyResponse">
    <wsdl:part name="result" type="xsd:int"/>
  </wsdl:message>

  <wsdl:portType name="RpcLiteralPortType">
    <!-- parameterOrder deliberately lists "b" before "a"; "opts" is absent and therefore last. -->
    <wsdl:operation name="Multiply" parameterOrder="b a">
      <wsdl:input message="tns:MultiplyRequest"/>
      <wsdl:output message="tns:MultiplyResponse"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="RpcLiteralBinding" type="tns:RpcLiteralPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Multiply">
      <soap:operation soapAction="urn:wb:rpclit:Multiply" style="rpc"/>
      <wsdl:input>
        <soap:body use="literal" namespace="urn:wb:rpclit"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal" namespace="urn:wb:rpclit"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="RpcLiteralService">
    <wsdl:port name="RpcLiteralPort" binding="tns:RpcLiteralBinding">
      <soap:address location="http://example.invalid/rpc-literal"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
