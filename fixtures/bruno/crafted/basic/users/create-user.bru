meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orgs/:orgId/users
  body: json
  auth: inherit
}

params:path {
  orgId: 42
}

headers {
  Content-Type: application/json
  ~X-Debug: 1
}

body:json {
  {
    "name": "Ada",
    "email": "ada@example.com"
  }
}

body:text {
  stale text left from another mode
}

assert {
  res.status: eq 201
  res.body.name: Ada
  ~res.body.id: isDefined
  res.body.age: between 1, 10
}

vars:post-response {
  userId: res.body.id
}

script:post-response {
  bru.setVar("userId", res.body.id);
}

tests {
  test("returns the created user", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Creates a user in the given org.
}
